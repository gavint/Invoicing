<!DOCTYPE html>
<html>
  <head>
    <title>Invoicer</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Invoicer", root_path, class: "navbar-brand" %>
        <div class="navbar-nav">
          <%= link_to "Dashboard", root_path, class: "nav-link" %>
          <%= link_to "Contacts", contacts_path, class: "nav-link" %>
          <%= link_to "Invoices", invoices_path, class: "nav-link" %>
          <%= link_to "Settings", edit_settings_path, class: "nav-link" %>
        </div>
      </div>
    </nav>
    <div class="container pb-5">
      <% if notice %><div class="alert alert-success"><%= notice %></div><% end %>
      <% if alert %><div class="alert alert-danger"><%= alert %></div><% end %>
      <%= yield %>
    </div>
  </body>
</html>
