<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <style>
      <%# Inlined rather than linked: Grover renders from a raw HTML string,
          not a live page load, so a <link> tag's /assets URL can't resolve
          without a running server. This file (app/assets/stylesheets/invoice.css)
          is still the one place to edit invoice styling. %>
      <%= raw File.read(Rails.root.join("app/assets/stylesheets/invoice.css")) %>
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
