<tr>
  <td><%= f.text_field :description, class: "form-control" %></td>
  <td><%= f.number_field :quantity, step: "1", min: "0", class: "form-control" %></td>
  <td><%= f.number_field :unit_price, step: "0.01", min: "0", class: "form-control" %></td>
  <td class="text-center align-middle">
    <% if f.object.persisted? %>
      <div class="form-check">
        <%= f.check_box :_destroy, class: "form-check-input" %>
        <%= f.label :_destroy, "Remove", class: "form-check-label small" %>
      </div>
    <% else %>
      <button type="button" class="btn btn-sm btn-outline-danger remove-item-row">&times;</button>
    <% end %>
  </td>
</tr>
