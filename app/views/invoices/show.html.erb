<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Invoice <%= @invoice.invoice_number %> <span class="badge bg-secondary"><%= @invoice.status %></span></h1>
  <div>
    <%= link_to "Edit", edit_invoice_path(@invoice), class: "btn btn-outline-secondary" %>
    <%= link_to "Download PDF", download_pdf_invoice_path(@invoice), class: "btn btn-outline-primary" %>
    <%= link_to "Email invoice", send_email_invoice_path(@invoice),
          data: { turbo_method: :post, turbo_confirm: "Send this invoice to #{@invoice.contact.email}?" },
          class: "btn btn-primary" %>
    <% unless @invoice.status == "paid" %>
      <%= link_to "Mark paid", mark_paid_invoice_path(@invoice),
            data: { turbo_method: :patch }, class: "btn btn-success" %>
    <% end %>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <h6 class="text-muted">Bill to</h6>
    <p>
      <%= link_to @invoice.contact.display_name, @invoice.contact %><br>
      <%= @invoice.contact.email %>
    </p>
  </div>
  <div class="col-md-6 text-md-end">
    <p>
      Issue date: <%= @invoice.issue_date&.strftime("%b %d, %Y") %><br>
      Due date: <%= @invoice.due_date&.strftime("%b %d, %Y") %><br>
      <% if @invoice.paid_at %>Paid: <%= @invoice.paid_at.strftime("%b %d, %Y") %><% end %>
    </p>
  </div>
</div>

<table class="table">
  <thead><tr><th>Description</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Total</th></tr></thead>
  <tbody>
    <% @invoice.invoice_items.each do |item| %>
      <tr>
        <td><%= item.description %></td>
        <td class="text-end"><%= item.quantity %></td>
        <td class="text-end"><%= number_to_currency(item.unit_price) %></td>
        <td class="text-end"><%= number_to_currency(item.line_total) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <th colspan="3" class="text-end">Total</th>
      <th class="text-end"><%= number_to_currency(@invoice.total) %></th>
    </tr>
  </tfoot>
</table>

<% if @invoice.notes.present? %>
  <h6 class="text-muted">Notes</h6>
  <p><%= simple_format(@invoice.notes) %></p>
<% end %>
