<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Invoices</h1>
  <%= link_to "New invoice", new_invoice_path, class: "btn btn-primary" %>
</div>

<div class="mb-3 d-flex align-items-center gap-3">
  <div class="btn-group">
    <%= link_to "All", invoices_path, class: "btn btn-sm #{params[:status].blank? ? 'btn-dark' : 'btn-outline-dark'}" %>
    <% (Invoice::STATUSES - ["void"]).each do |status| %>
      <%= link_to status.capitalize, invoices_path(status: status), class: "btn btn-sm #{params[:status] == status ? 'btn-dark' : 'btn-outline-dark'}" %>
    <% end %>
  </div>

  <%= form_with url: invoices_path, method: :get, local: true do %>
    <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
    <div class="form-check mb-0">
      <%= check_box_tag :show_void, "1", @show_void, class: "form-check-input", onchange: "this.form.requestSubmit()" %>
      <%= label_tag :show_void, "Show void invoices", class: "form-check-label" %>
    </div>
  <% end %>
</div>

<% if @invoices.empty? %>
  <p class="text-muted">No invoices yet.</p>
<% else %>
  <table class="table table-striped">
    <thead><tr><th>Number</th><th>Contact</th><th>Issue date</th><th>Due date</th><th>Status</th><th>Total</th><th></th></tr></thead>
    <tbody>
      <% @invoices.each do |invoice| %>
        <tr class="<%= 'table-danger' if invoice.overdue? %>">
          <td><%= link_to invoice.invoice_number, invoice %></td>
          <td><%= link_to invoice.contact.display_name, invoice.contact %></td>
          <td><%= invoice.issue_date&.strftime("%b %d, %Y") %></td>
          <td><%= invoice.due_date&.strftime("%b %d, %Y") %></td>
          <td><span class="badge bg-secondary"><%= invoice.status %></span></td>
          <td><%= number_to_currency(invoice.total) %></td>
          <td class="text-end">
            <% unless invoice.status == "paid" %>
              <%= link_to "Mark paid", mark_paid_invoice_path(invoice),
                    data: { turbo_method: :patch }, class: "btn btn-sm btn-outline-success" %>
            <% end %>
            <% if invoice.status == "void" %>
              <%= link_to "Delete", invoice_path(invoice),
                    data: { turbo_method: :delete, turbo_confirm: "Delete invoice #{invoice.invoice_number}? This can't be undone." },
                    class: "btn btn-sm btn-outline-danger" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
