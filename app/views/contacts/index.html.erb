<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Contacts</h1>
  <%= link_to "New contact", new_contact_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped">
  <thead><tr><th>Name</th><th>Company</th><th>Email</th><th>Phone</th><th></th></tr></thead>
  <tbody>
    <% @contacts.each do |contact| %>
      <tr>
        <td><%= link_to contact.name, contact %></td>
        <td><%= contact.company_name %></td>
        <td><%= contact.email %></td>
        <td><%= contact.phone %></td>
        <td class="text-end">
          <%= link_to "Edit", edit_contact_path(contact), class: "btn btn-sm btn-outline-secondary" %>
          <%= link_to "Delete", contact,
                data: { turbo_method: :delete, turbo_confirm: "Delete this contact?" },
                class: "btn btn-sm btn-outline-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
