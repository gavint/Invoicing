<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= @contact.display_name %></h1>
  <div>
    <%= link_to "Edit", edit_contact_path(@contact), class: "btn btn-outline-secondary" %>
    <%= link_to "New invoice", new_invoice_path(invoice: { contact_id: @contact.id }), class: "btn btn-primary" %>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <h5>Contact details</h5>
    <p>
      <%= @contact.name %><br>
      <%= @contact.email %><br>
      <%= @contact.phone %>
    </p>
  </div>
  <div class="col-md-6">
    <h5>Billing address</h5>
    <p>
      <%= @contact.billing_address_line1 %><br>
      <%= @contact.billing_address_line2 %><br>
      <%= [@contact.billing_city, @contact.billing_state, @contact.billing_zip].compact_blank.join(", ") %><br>
      <%= @contact.billing_country %>
    </p>
  </div>
</div>

<h5>Invoices</h5>
<% if @invoices.empty? %>
  <p class="text-muted">No invoices yet.</p>
<% else %>
  <table class="table table-striped">
    <thead><tr><th>Number</th><th>Status</th><th>Total</th><th>Due</th></tr></thead>
    <tbody>
      <% @invoices.each do |invoice| %>
        <tr>
          <td><%= link_to invoice.invoice_number, invoice %></td>
          <td><span class="badge bg-secondary"><%= invoice.status %></span></td>
          <td><%= number_to_currency(invoice.total) %></td>
          <td><%= invoice.due_date&.strftime("%b %d, %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
